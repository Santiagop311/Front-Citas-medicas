---
/* src/pages/users.astro */
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Usuarios</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>

  <body class="bg-gray-50 min-h-screen">
    <div id="toastContainer" class="fixed top-5 right-5 flex flex-col space-y-2 z-50"></div>

    <main class="container mx-auto px-6 py-12">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-blue-gray-800">Lista de Usuarios</h1>
        <button
          id="openModal"
          class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg shadow-md transition"
        >
          + Crear Usuario
        </button>
      </div>

      <!-- Contenedor dinámico -->
      <div id="usersTableContainer">
        <div
          class="text-center text-gray-500 bg-white shadow-md p-6 rounded-lg"
        >
          Cargando usuarios...
        </div>
      </div>

      <!-- MODAL -->
      <div
        id="modal"
        class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50"
      >
        <div
          class="bg-white rounded-lg shadow-lg w-full max-w-lg p-6 relative animate-fadeIn"
        >
          <button
            id="closeModal"
            class="absolute top-2 right-2 text-gray-500 hover:text-gray-700"
          >
            ✕
          </button>
          <h2 class="text-2xl font-bold mb-4 text-blue-gray-800">
            Crear Usuario
          </h2>

          <form id="createUserForm" class="space-y-4">
            <div>
              <label class="block text-gray-700 mb-1">Nombre</label>
              <input
                type="text"
                name="name"
                required
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200"
              />
            </div>

            <div>
              <label class="block text-gray-700 mb-1">Correo electrónico</label>
              <input
                type="email"
                name="email"
                required
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200"
              />
            </div>

            <div>
              <label class="block text-gray-700 mb-1">Contraseña</label>
              <input
                type="password"
                name="password"
                required
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200"
              />
            </div>

            <div>
              <label class="block text-gray-700 mb-1">Rol</label>
              <select
                name="role_id"
                required
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200"
              >
                <option value="">Seleccione un rol</option>
                <option value="1">Admin</option>
                <option value="2">Médico</option>
                <option value="3">Secretario</option>
                <option value="4">Cliente</option>
              </select>
            </div>

            <div class="pt-4 flex justify-end">
              <button
                type="submit"
                class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md"
              >
                Guardar
              </button>
            </div>
          </form>
        </div>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", async () => {
        const container = document.getElementById("usersTableContainer");
        const modal = document.getElementById("modal");
        const openModal = document.getElementById("openModal");
        const closeModal = document.getElementById("closeModal");
        const form = document.getElementById("createUserForm");

        // --- Función para renderizar la tabla ---
        async function loadUsers() {
          container.innerHTML =
            '<div class="text-center text-gray-500 bg-white shadow-md p-6 rounded-lg">Cargando usuarios...</div>';

          try {
            const res = await axios.get("http://localhost:8000/api/users");
            const users = res.data;

            if (!users.length) {
              container.innerHTML =
                '<div class="text-center text-gray-500 bg-white shadow-md p-6 rounded-lg">No hay usuarios disponibles.</div>';
              return;
            }

            const rows = users
              .map(
                (user) => `
              <tr class="border-b hover:bg-blue-50 transition">
                <td class="py-3 px-5 text-gray-700">${user.id}</td>
                <td class="py-3 px-5 text-gray-900 font-medium">${user.name}</td>
                <td class="py-3 px-5 text-gray-700">${user.email}</td>
                <td class="py-3 px-5 text-gray-700 capitalize">${
                  user.role?.name || "—"
                }</td>
              </tr>`
              )
              .join("");

            container.innerHTML = `
              <div class="overflow-x-auto shadow-lg rounded-lg bg-white">
                <table class="min-w-full text-left border-collapse">
                  <thead class="bg-blue-100 border-b">
                    <tr>
                      <th class="py-3 px-5 text-gray-800 font-semibold">ID</th>
                      <th class="py-3 px-5 text-gray-800 font-semibold">Nombre</th>
                      <th class="py-3 px-5 text-gray-800 font-semibold">Email</th>
                      <th class="py-3 px-5 text-gray-800 font-semibold">Rol</th>
                    </tr>
                  </thead>
                  <tbody>${rows}</tbody>
                </table>
              </div>`;
          } catch (error) {
            console.error(error);
            container.innerHTML =
              '<div class="text-center text-red-500 bg-white shadow-md p-6 rounded-lg">Error al cargar los usuarios.</div>';
          }
        }

        // --- Inicializar ---
        loadUsers();

        // --- Modal ---
        openModal.addEventListener("click", () =>
          modal.classList.remove("hidden")
        );
        closeModal.addEventListener("click", () =>
          modal.classList.add("hidden")
        );

        // --- Crear usuario ---
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const data = Object.fromEntries(new FormData(form));

          try {
            await axios.post("http://localhost:8000/api/users", data);
            showToast("Usuario creado correctamente", "success");

            modal.classList.add("hidden");
            form.reset();
            loadUsers(); // 🔹 refresca la tabla sin recargar la página
          } catch (error) {
            console.error(error);
            showToast("Error al crear el usuario", "error");
          }
        });

        // --- Toast ---
        function showToast(message, type = "success") {
          const toastContainer = document.getElementById("toastContainer");
          const toast = document.createElement("div");
          toast.className = `px-4 py-2 rounded shadow text-white font-medium ${
            type === "success" ? "bg-green-500" : "bg-red-500"
          } animate-fadeIn`;
          toast.textContent = message;
          toastContainer.appendChild(toast);

          setTimeout(() => {
            toast.classList.add("opacity-0", "transition", "duration-500");
            setTimeout(() => toast.remove(), 500);
          }, 3000);
        }
      });
    </script>

    <style>
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fadeIn {
        animation: fadeIn 0.3s ease-in-out;
      }
    </style>
  </body>
</html>
