---
// src/pages/appointments.astro
import api from "../lib/api";

let appointments = [];
let users = []; // para seleccionar médico y cliente

try {
  const appointmentsRes = await api.get("/appointments");
  appointments = appointmentsRes.data;

  const usersRes = await api.get("/users");
  users = usersRes.data;
} catch (error) {
  console.error("Error al obtener datos:", error);
}
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Citas</title>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <div id="toastContainer" class="fixed top-5 right-5 flex flex-col space-y-2 z-50"></div>

    <main class="container mx-auto px-6 py-12">
      <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-blue-gray-800">Gestión de Citas</h1>
        <button id="openModal" class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2 rounded-lg shadow-md transition">
          + Crear Cita
        </button>
      </div>

      {appointments.length > 0 ? (
        <div class="overflow-x-auto shadow-lg rounded-lg bg-white">
          <table class="min-w-full text-left border-collapse">
            <thead class="bg-blue-100 border-b">
              <tr>
                <th class="py-3 px-5 text-gray-800 font-semibold">ID</th>
                <th class="py-3 px-5 text-gray-800 font-semibold">Médico</th>
                <th class="py-3 px-5 text-gray-800 font-semibold">Cliente</th>
                <th class="py-3 px-5 text-gray-800 font-semibold">Fecha</th>
                <th class="py-3 px-5 text-gray-800 font-semibold">Hora</th>
                <th class="py-3 px-5 text-gray-800 font-semibold">Estado</th>
              </tr>
            </thead>
            <tbody>
              {appointments.map(appointment => (
                <tr class="border-b hover:bg-blue-50 transition">
                  <td class="py-3 px-5 text-gray-700">{appointment.id}</td>
                  <td class="py-3 px-5 text-gray-900 font-medium">{appointment.doctor?.name || "—"}</td>
                  <td class="py-3 px-5 text-gray-700">{appointment.client?.name || "—"}</td>
                  <td class="py-3 px-5 text-gray-700">{appointment.date}</td>
                  <td class="py-3 px-5 text-gray-700">{appointment.time}</td>
                  <td class="py-3 px-5 text-gray-700 capitalize">{appointment.status || "Pendiente"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="text-center text-gray-500 bg-white shadow-md p-6 rounded-lg">No hay citas disponibles.</div>
      )}

      <!-- MODAL CREAR CITA -->
      <div id="modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg shadow-lg w-full max-w-lg p-6 relative">
          <button id="closeModal" class="absolute top-2 right-2 text-gray-500 hover:text-gray-700">✕</button>
          <h2 class="text-2xl font-bold mb-4">Crear Cita</h2>

          <form id="createAppointmentForm" class="space-y-4">
            <div>
              <label class="block text-gray-700 mb-1">Médico</label>
              <select name="doctor_id" required class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200">
                <option value="">Seleccione un médico</option>
                {users.filter(u => u.role?.name === "Médico").map(u => (
                  <option value={u.id}>{u.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-gray-700 mb-1">Cliente</label>
              <select name="client_id" required class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200">
                <option value="">Seleccione un cliente</option>
                {users.filter(u => u.role?.name === "Cliente").map(u => (
                  <option value={u.id}>{u.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-gray-700 mb-1">Fecha</label>
              <input type="date" name="date" required class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200" />
            </div>

            <div>
              <label class="block text-gray-700 mb-1">Hora</label>
              <input type="time" name="time" required class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200" />
            </div>

            <div>
              <label class="block text-gray-700 mb-1">Estado</label>
              <select name="status" required class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring focus:ring-blue-200">
                <option value="Pendiente">Pendiente</option>
                <option value="Confirmada">Confirmada</option>
                <option value="Cancelada">Cancelada</option>
              </select>
            </div>

            <div class="pt-4 flex justify-end">
              <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md">Guardar</button>
            </div>
          </form>
        </div>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
      const modal = document.getElementById("modal");
      const openModal = document.getElementById("openModal");
      const closeModal = document.getElementById("closeModal");
      const form = document.getElementById("createAppointmentForm");

      openModal.addEventListener("click", () => modal.classList.remove("hidden"));
      closeModal.addEventListener("click", () => modal.classList.add("hidden"));

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const data = Object.fromEntries(new FormData(form));

        try {
          await axios.post("http://localhost:8000/api/appointments", data);
          showToast("Cita creada correctamente", "success");
          modal.classList.add("hidden");
          setTimeout(() => location.reload(), 1000);
        } catch (error) {
          console.error(error);
          showToast("Error al crear la cita", "error");
        }
      });

      function showToast(message, type = "success") {
        const toastContainer = document.getElementById("toastContainer");
        const toast = document.createElement("div");
        toast.className = `px-4 py-2 rounded shadow text-white font-medium ${
          type === "success" ? "bg-green-500" : "bg-red-500"
        } animate-slide-in`;
        toast.textContent = message;
        toastContainer.appendChild(toast);

        setTimeout(() => {
          toast.classList.add("opacity-0", "transition", "duration-500");
          setTimeout(() => toast.remove(), 500);
        }, 3000);
      }
    </script>
  </body>
</html>
